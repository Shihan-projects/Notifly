# Slack app -> Basic Information -> Signing Secret
SLACK_SIGNING_SECRET=

# Your Slack member ID (profile -> ... -> Copy member ID), e.g. U0123ABCD
MY_USER_ID=

# Private channel ID (channel name -> bottom of the details panel), e.g. C0123ABCD
CHANNEL_ID=

# Random key shared with the ESP32. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_KEY=

# Added automatically when you connect Upstash Redis in Vercel:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
